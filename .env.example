# Copy to .env and fill in. The Storefront token is minted through the Admin API
# with storefrontAccessTokenCreate, which is DENIED unless the app already holds
# unauthenticated_* scopes, and the denial does not say so.
SESSION_SECRET=change-me
PUBLIC_STORE_DOMAIN=your-store.myshopify.com
PUBLIC_STOREFRONT_API_TOKEN=
PUBLIC_STOREFRONT_API_VERSION=2026-07
# Required by Analytics.Provider. Without it the provider throws on every render.
PUBLIC_CHECKOUT_DOMAIN=your-store.myshopify.com
